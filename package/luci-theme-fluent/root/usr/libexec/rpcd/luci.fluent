#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

if command -v apk >/dev/null 2>&1; then
	PKG_EXT=".apk"
else
	PKG_EXT=".ipk"
fi

readonly bg_path="/www/luci-static/fluent/background"
readonly tmp_path="/tmp/fluent_background.tmp"
readonly update_pkg="/tmp/fluent-update${PKG_EXT}"
readonly update_log="/tmp/fluent-update.log"
readonly update_pid="/tmp/fluent-update.pid"
readonly update_status="/tmp/fluent-update.status"
readonly install_log="/tmp/fluent-install.log"
readonly install_pid="/tmp/fluent-install.pid"
readonly install_status="/tmp/fluent-install.status"

valid_background_name() {
	case "$1" in
		""|"."|".."|*/*|*\\*|*[!A-Za-z0-9._-]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_release_url() {
	case "$1" in
		https://github.com/jxstarthxr/luci-theme-fortiwifi-30e/releases/download/*) return 0 ;;
		https://ghfast.top/https://github.com/jxstarthxr/luci-theme-fortiwifi-30e/releases/download/*) return 0 ;;
		*) return 1 ;;
	esac
}

process_is_running() {
	pid_file="$1"
	status_file="$2"
	tracked_pid=""
	[ -f "$status_file" ] && return 1
	[ -f "$pid_file" ] && tracked_pid=$(sed -n '1p' "$pid_file")
	case "$tracked_pid" in
		""|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$tracked_pid" 2>/dev/null
}

download_file() {
	url="$1"
	destination="$2"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -O "$destination" "$url"
	else
		wget -O "$destination" "$url"
	fi
}

download_worker() {
	main_url="$1"
	i18n_urls="$2"
	result=0

	download_file "$main_url" "$update_pkg" || result=$?
	idx=1
	if [ "$result" -eq 0 ]; then
		for i18n_url in $i18n_urls; do
			download_file "$i18n_url" "/tmp/fluent-i18n-${idx}${PKG_EXT}" || {
				result=$?
				break
			}
			idx=$((idx + 1))
		done
	fi

	echo "$result" >"$update_status"
	exit "$result"
}

install_worker() {
	sleep 1
	result=0
	if command -v apk >/dev/null 2>&1; then
		apk add --allow-untrusted "$@" || result=$?
	else
		opkg install "$@" || result=$?
	fi
	rm -f "$@"
	echo "$result" >"$install_status"
	/etc/init.d/rpcd restart
	exit "$result"
}

case "$1" in
	"download_worker")
		download_worker "$2" "$3"
		;;
	"install_worker")
		shift
		install_worker "$@"
		;;
esac

case "$1" in
	"list")
	json_init
	json_add_object "avail"
	json_close_object
	json_add_object "remove"
		json_add_string "filename" "filename"
	json_close_object
	json_add_object "rename"
		json_add_string "newname" "filename"
	json_close_object
	json_add_object "set_mode"
		json_add_string "mode" "mode"
	json_close_object
	json_add_object "get_version"
	json_close_object
	json_add_object "start_download"
		json_add_string "url" "url"
		json_add_string "i18n_url" "i18n_url"
		json_add_string "i18n_urls" "i18n_urls"
	json_close_object
	json_add_object "check_download"
	json_close_object
	json_add_object "do_install"
		json_add_string "hash" "hash"
		json_add_string "i18n_hash" "i18n_hash"
		json_add_string "i18n_hashes" "i18n_hashes"
	json_close_object
	json_add_object "check_install"
	json_close_object
	json_add_object "get_install_log"
	json_close_object
	json_dump
	json_cleanup
	;;
"call")
	case "$2" in
	"avail")
		json_init
		json_add_int "avail" "$(df | grep -E '/$' | awk '{print $4}')"
		json_dump
		json_cleanup
		;;
	"remove")
		read -r input
		json_load "$input"
		json_get_var filename "filename"
		json_cleanup
		if ! valid_background_name "$filename"; then
			echo '{ "result": 255 }'
			exit 255
		fi
		rm -f "$bg_path/$filename"
		echo '{ "result": 0 }'
		;;
	"rename")
		read -r input
		json_load "$input"
		json_get_var newname "newname"
		json_cleanup
		if ! valid_background_name "$newname"; then
			echo '{ "result": 255 }'
			exit 255
		fi
		mkdir -p "$bg_path"
		if mv "$tmp_path" "$bg_path/$newname" 2>"/dev/null"; then
			chmod 0644 "$bg_path/$newname"
			echo '{ "result": 0 }'
		else
			echo '{ "result": 1 }'
		fi
		;;
	"set_mode")
		read -r input
		json_load "$input"
		json_get_var mode "mode"
		json_cleanup
		case "$mode" in
			light|dark|auto) ;;
			*)
				echo '{ "result": 255 }'
				exit 255
				;;
		esac
		if uci -q set fluent.@global[0].mode="$mode" && uci -q commit fluent; then
			echo '{ "result": 0 }'
		else
			echo '{ "result": 1 }'
		fi
		;;
	"get_version")
		version=""
		pkg_type="ipk"
		i18n_installed=0
		installed_i18n=""
		if command -v apk >/dev/null 2>&1; then
			pkg_type="apk"
			version=$(apk list -I luci-theme-fluent 2>/dev/null | awk '{print $1}' | sed 's/^luci-theme-fluent-//' | head -1)
			installed_i18n=$(apk list -I 2>/dev/null | grep -E '^luci-i18n-fluent-' | awk '{print $1}' | sed 's/^luci-i18n-fluent-//')
		else
			version=$(opkg status luci-theme-fluent 2>/dev/null | grep -m1 'Version:' | awk '{print $2}')
			installed_i18n=$(opkg list-installed 2>/dev/null | grep -E '^luci-i18n-fluent-' | awk '{print $1}' | sed 's/^luci-i18n-fluent-//')
		fi
		if echo "$installed_i18n" | grep -q "^zh-cn$"; then
			i18n_installed=1
		fi
		if [ -z "$version" ]; then
			version="1.0.1-dev"
		fi
		json_init
		json_add_string "version" "$version"
		json_add_string "pkg_type" "$pkg_type"
		json_add_boolean "i18n_zh_cn_installed" "$i18n_installed"
		json_add_array "installed_i18n"
		for lang in $installed_i18n; do
			json_add_string "" "$lang"
		done
		json_close_array
		json_dump
		json_cleanup
		;;
	"start_download")
		read -r input
		json_load "$input"
		json_get_var url "url"
		json_get_var i18n_url "i18n_url"
		json_get_var i18n_urls "i18n_urls"
		json_cleanup
		if process_is_running "$update_pid" "$update_status"; then
			echo '{ "result": 255, "message": "Another theme download is already running" }'
			exit 255
		fi

		urls_to_dl="${i18n_urls:-$i18n_url}"
		if [ -z "$url" ]; then
			echo '{ "result": 255, "message": "Missing URL" }'
			exit 255
		fi
		if ! valid_release_url "$url"; then
			echo '{ "result": 255, "message": "Release URL is not allowed" }'
			exit 255
		fi
		for i18n_download_url in $urls_to_dl; do
			if ! valid_release_url "$i18n_download_url"; then
				echo '{ "result": 255, "message": "Translation URL is not allowed" }'
				exit 255
			fi
		done

		rm -f "$update_pkg" /tmp/fluent-i18n-* "$update_log" "$update_pid" "$update_status"
		nohup /usr/libexec/rpcd/luci.fluent download_worker "$url" "$urls_to_dl" >"$update_log" 2>&1 &
		echo "$!" >"$update_pid"
		echo '{ "result": 0 }'
		;;
	"check_download")
		json_init
		size=0
		for downloaded_file in "$update_pkg" /tmp/fluent-i18n-*; do
			[ -f "$downloaded_file" ] || continue
			downloaded_size=$(wc -c <"$downloaded_file")
			size=$((size + downloaded_size))
		done
		json_add_int "size" "$size"

		if process_is_running "$update_pid" "$update_status"; then
			json_add_boolean "running" 1
		else
			json_add_boolean "running" 0
			download_code=255
			[ -f "$update_status" ] && download_code=$(sed -n '1p' "$update_status")
			json_add_int "code" "${download_code:-255}"
		fi
		json_dump
		json_cleanup
		;;
	"do_install")
		read -r input
		json_load "$input"
		json_get_var hash "hash"
		json_get_var i18n_hash "i18n_hash"
		json_get_var i18n_hashes "i18n_hashes"
		json_cleanup
		if process_is_running "$install_pid" "$install_status"; then
			echo '{ "result": 255, "message": "Another theme installation is already running" }'
			exit 255
		fi

		download_code=255
		[ -f "$update_status" ] && download_code=$(sed -n '1p' "$update_status")
		if [ "$download_code" != "0" ]; then
			echo '{ "result": 255, "message": "Theme download did not complete successfully" }'
			exit 255
		fi

		if [ -z "$hash" ]; then
			echo '{ "result": 255, "message": "Missing hash parameter" }'
			exit 255
		fi

		if [ ! -f "$update_pkg" ]; then
			echo '{ "result": 255, "message": "Package file not found" }'
			exit 255
		fi

		if [ "$hash" != "skip" ]; then
			if ! echo "$hash" | grep -qE '^[0-9a-fA-F]{64}$'; then
				echo '{ "result": 255, "message": "Invalid hash parameter" }'
				exit 255
			fi
			actual_hash=$(sha256sum "$update_pkg" | awk '{print $1}')
			if [ "$actual_hash" != "$hash" ]; then
				echo '{ "result": 255, "message": "Hash verification failed" }'
				exit 255
			fi
		fi

		hashes_to_check="${i18n_hashes:-$i18n_hash}"
		i18n_file_count=0
		for target_i18n_pkg in /tmp/fluent-i18n-*; do
			[ -f "$target_i18n_pkg" ] || continue
			i18n_file_count=$((i18n_file_count + 1))
		done
		i18n_hash_count=0
		for unused_hash in $hashes_to_check; do
			i18n_hash_count=$((i18n_hash_count + 1))
		done
		if [ "$i18n_hash_count" -ne "$i18n_file_count" ]; then
			echo '{ "result": 255, "message": "Translation package hash count does not match downloaded files" }'
			exit 255
		fi
		if [ "$i18n_hash_count" -gt 0 ]; then
			idx=1
			for h in $hashes_to_check; do
				target_i18n_pkg="/tmp/fluent-i18n-${idx}${PKG_EXT}"
				if [ ! -f "$target_i18n_pkg" ]; then
					echo '{ "result": 255, "message": "Translation package file not found" }'
					exit 255
				fi
				if [ "$h" != "skip" ]; then
					if ! echo "$h" | grep -qE '^[0-9a-fA-F]{64}$'; then
						echo '{ "result": 255, "message": "Invalid i18n hash parameter" }'
						exit 255
					fi
					actual_i18n_hash=$(sha256sum "$target_i18n_pkg" | awk '{print $1}')
					if [ "$actual_i18n_hash" != "$h" ]; then
						echo '{ "result": 255, "message": "i18n Hash verification failed" }'
						exit 255
					fi
				fi
				idx=$((idx + 1))
			done
		fi

		set -- "$update_pkg"
		for i18n_file in /tmp/fluent-i18n-*; do
			[ -f "$i18n_file" ] || continue
			set -- "$@" "$i18n_file"
		done

		rm -f "$install_log" "$install_pid" "$install_status"
		nohup /usr/libexec/rpcd/luci.fluent install_worker "$@" >"$install_log" 2>&1 &
		echo "$!" >"$install_pid"

		echo '{ "result": 0 }'
		;;
	"check_install")
		json_init
		if process_is_running "$install_pid" "$install_status"; then
			json_add_boolean "running" 1
		else
			json_add_boolean "running" 0
			install_code=255
			[ -f "$install_status" ] && install_code=$(sed -n '1p' "$install_status")
			json_add_int "code" "${install_code:-255}"
		fi
		json_dump
		json_cleanup
		;;
	"get_install_log")
		json_init
		if [ -f "$install_log" ]; then
			json_add_string "log" "$(cat "$install_log")"
		else
			json_add_string "log" ""
		fi
		json_dump
		json_cleanup
		;;
	esac
	;;
esac
